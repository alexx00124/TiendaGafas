{
  "setupFiles": [
      "raf/polyfill",
      "<rootDir>/test/setup.js"
  ],
  "snapshotSerializers": [
      "enzyme-to-json/serializer"
  ],
  "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|webp|svg|css|scss|sass)$": "<rootDir>/test/mocks/fileMock.js",
      "^@/(.*)$": "<rootDir>/src/$1"
  },
  "transformIgnorePatterns": [
      "/node_modules/(?!(@wojtekmaj|enzyme)/)"
  ],
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.jsx",
      "!src/**/index.js",
      "!src/constants/**",
      "!src/**/*.{test,spec}.{js,jsx}"
  ],
  "coverageReporters": ["text", "lcov", "clover"]
}